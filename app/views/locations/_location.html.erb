<div id="<%= dom_id location %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= location.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Aliases:</strong>
    [<%= location.aliases %>]
  </div>
  <div>
    <strong class="block font-medium mb-1">Lon:</strong>
    <%= location.lon %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Lat:</strong>
    <%= location.lat %>
  </div>
</div>
