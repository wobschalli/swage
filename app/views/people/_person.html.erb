<div id="<%= dom_id person %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= person.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Location:</strong>
    <%= person.location_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Username:</strong>
    <%= person.username %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Grad year:</strong>
    <%= person.grad_year %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Discord:</strong>
    <%= person.discord_id %>
  </div>
</div>
